# Copy this file to backend/.env and fill in optional API keys
# The app works without any API keys using RSS feeds and Hacker News

# Port for the backend API server (default: 3001)
PORT=3001

# Optional: NewsAPI.org — adds more news article sources
# Get a free key at https://newsapi.org (100 req/day free)
# NEWS_API_KEY=your_key_here

# Optional: YouTube Data API v3 — adds YouTube video results
# Get a key at https://console.cloud.google.com
# Enable "YouTube Data API v3" and create an API key
# YOUTUBE_API_KEY=your_key_here
